# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 git에 커밋되지 않음)
# 서버 전용 키 — NEXT_PUBLIC_ 접두사를 붙이지 마세요(클라이언트 노출 금지).

# AI 상담 (app/api/chat)
OPENAI_API_KEY=

# 문의 메일 발송 (app/api/contact — Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# 관리자 페이지 (/admin)
# ADMIN_SESSION_SECRET 은 긴 무작위 문자열 (예: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 문의 DB 저장 (Supabase — supabase/schema.sql 실행 후 Settings→API 값)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 오시는 길 지도 (Maps JavaScript API — HTTP 리퍼러 제한 권장)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_KAKAO_MAPS_APP_KEY=
